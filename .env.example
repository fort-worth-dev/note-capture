# -----------------------------------------------------------------------------
# Supabase — project "note-capture" (Step 1.2)
#
# Copy to `.env` / `.env.local` as needed; never commit real secrets.
#
# Where to find values (Supabase Dashboard → your project):
#   Project Settings → Data API (or legacy "API"):
#     - Project URL        → SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
#     - anon public        → SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY
#     - service_role       → SUPABASE_SERVICE_ROLE_KEY (secret; backend only)
#   Project Settings → API Keys → JWT Signing Keys / JWT Secret:
#     - JWT secret (for verifying user JWTs) → SUPABASE_JWT_SECRET (secret; backend only)
#
# Auth — Email magic link (Step 1.2):
#   Authentication → Sign In / Providers → Email:
#     - Enable the Email provider.
#     - Use "Magic Link" / OTP sign-in (no password required for magic-link-only UX).
#   For local development, turn OFF "Confirm email" on the same Email provider
#   screen so magic links work immediately without clicking a confirmation email first.
# -----------------------------------------------------------------------------

# --- Shared (public) ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend only (never expose to the browser or frontend bundle) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Postgres (Supabase → Project Settings → Database → connection string / pooler URI).
# Use in notes/backend/.env so FastAPI can open an asyncpg pool (Step 1.4).
# If the password contains @ ? * : etc., percent-encode them in the URI (e.g. @ → %40).
# On WSL2, direct `db.<project>.supabase.co` can hit unreachable IPv6 first; the backend
# resolves the hostname and tries IPv4 before IPv6. Session pooler URIs (port 6543) also work.
DATABASE_URL=

# Optional: comma-separated origins for FastAPI CORS (default http://localhost:3000).
# CORS_ORIGINS=http://localhost:3000
